[Unit]
Description=PPP PRIVATE NETWORK™ 2 - Client (Dual Mode)
After=network.target network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/ppp/client
ExecStart=/bin/bash /opt/ppp/client/ppp-client.sh
ExecStop=/bin/bash -c 'tmux send-keys -t ppp-client C-c 2>/dev/null; sleep 2; tmux kill-session -t ppp-client 2>/dev/null'
Restart=always
RestartSec=20
StartLimitBurst=5
StartLimitIntervalSec=60
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
SyslogIdentifier=ppp-client

[Install]
WantedBy=multi-user.target
